# Unison profile for Amazon Cloud Desktop

# Roots of the synchronization
root = /Volumes/workplace
root = ssh://clouddesk//workplace/dumatte

# Amazon-specific ignores
ignore = BelowPath */{env,logs,out}

# Host-specific Brazil state. config/brazil.prefs carries the macOS platform
# overlay setting; syncing it to Cloud Desktop makes Brazil resolve Mac binaries
# there (2026-09-16: CPython310Runtime arrived as Mach-O in /mybc, breaking
# every python3-based build step). rust-toolchain.toml holds the absolute
# toolchain path of the host that ran brazil-build sync.
ignore = Path */config/brazil.prefs
ignore = Path */.brazil
ignore = Path */.builder-mcp
ignore = Path */packageInfo.bak
ignore = Name rust-toolchain.toml

# Brazil trash: contains moved-aside env trees with platform-specific
# binaries (Mach-O locally, ELF remotely). Never sync, at any depth.
ignore = Name .brazil_trash

# Brazil package cache: platform-specific, never sync
ignore = Name brazil-pkg-cache

# Package-level build dirs: platform-specific toolchains and artifacts
# (cargo-home, cargo-brazil-toolchain, registries). Never sync.
ignore = Path */src/*/build
ignore = BelowPath */src/*/build

# Rust/Cargo build artifacts (platform-specific, never sync)
ignore = BelowPath */target
ignore = Name .cargo-ok

# Brazil build artifacts (keep test output)
ignore    = Path */build/*/*/*/*/build/{,.}?*
ignorenot = Path */build/*/*/*/*/build/brazil-integration-tests
ignore    = Path */build/*/*/*/*/build/brazil-integration-tests/{,.}?*
ignorenot = Path */build/*/*/*/*/build/brazil-integration-tests/{*.html,*.css,com}
ignorenot = Path */build/*/*/*/*/build/brazil-integ-tests
ignore    = Path */build/*/*/*/*/build/brazil-integ-tests/{,.}?*
ignorenot = Path */build/*/*/*/*/build/brazil-integ-tests/{*.html,*.css,com}
ignorenot = Path */build/*/*/*/*/build/brazil-unit-tests
ignore    = Path */build/*/*/*/*/build/brazil-unit-tests/{,.}?*
ignorenot = Path */build/*/*/*/*/build/brazil-unit-tests/{*.html,*.css,com}
ignorenot = Path */build/*/*/*/*/build/generated-src
ignore    = Path */build/*/*/*/*/build/generated-src/{,.}?*
ignorenot = Path */build/*/*/*/*/build/generated-src/{*.html,*.css,com}

# Log output
log = true
logfile = /Users/dumatte/.local/state/unison/amazon.log

# Include shared settings
include common.prf

# vim: ft=dosini
